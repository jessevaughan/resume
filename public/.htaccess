# Force HTTPS on resume.jessevaughan.com.
#
# Lives in public/ so Vite copies it into dist/ at build — that way it ships
# with every deploy and survives the rsync --delete step (a .htaccess placed
# on the server by hand would get wiped on the next deploy).
#
# IMPORTANT: only effective once the Let's Encrypt cert is active. If this
# reaches the server before the cert exists, HTTP visitors get 301'd to a
# broken TLS endpoint and the site is unreachable. Deploy after the cert is live.

RewriteEngine On

# Leave ACME challenges on plain HTTP so cert auto-renewal can't be blocked.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Prerendered tracks. Extensionless on purpose: /engineering, not
# /engineering/ and not /engineering.html. Serving the file through a rewrite
# keeps the clean URL without Apache adding the trailing slash it would for a
# directory. Guarded by -f so a plain `npm run build` deploy falls through to
# the SPA rule below instead of 404ing.
RewriteCond %{DOCUMENT_ROOT}/engineering.html -f
RewriteRule ^engineering/?$ /engineering.html [L]

RewriteCond %{DOCUMENT_ROOT}/creative.html -f
RewriteRule ^creative/?$ /creative.html [L]

# ── Track routes ───────────────────────────────────────────────────────
# Each track is a path (see src/tracks.ts). The app resolves the track from
# the path client-side, so both routes serve the same SPA shell.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(creative|engineering)/?$ /index.html [L]